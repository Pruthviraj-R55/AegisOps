# Development placeholders only. Never place real credentials in this file.
AEGISOPS_ENV=development
AEGISOPS_LOG_LEVEL=INFO

# Collector local state and tenant identity (tenant comes from trusted local config).
COLLECTOR_ID=local-dev-collector
COLLECTOR_TENANT_ID=development-tenant
COLLECTOR_QUEUE_PATH=./var/collector-queue.sqlite3

# Set only after the SaaS owner has supplied a deployment URL and credential.
SAAS_BASE_URL=
COLLECTOR_BEARER_TOKEN=

# Organizer stream values intentionally omitted until the organizer shares details.
ORGANIZER_STREAM_URL=
ORGANIZER_STREAM_AUTH=

# SaaS development settings; use a local secret and database URL outside source control.
POSTGRES_DB=aegisops
POSTGRES_USER=aegisops
POSTGRES_PASSWORD=aegisops-local-only
SAAS_DATABASE_URL=postgresql+psycopg://aegisops:aegisops-local-only@localhost:5432/aegisops
SAAS_DEV_TOKEN=
