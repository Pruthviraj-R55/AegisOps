# Development placeholders only. Never place real credentials in this file.
AEGISOPS_ENV=development
AEGISOPS_LOG_LEVEL=INFO

# Collector local state and tenant identity (tenant comes from trusted local config).
COLLECTOR_ID=local-dev-collector
COLLECTOR_TENANT_ID=development-tenant
COLLECTOR_QUEUE_PATH=./var/collector-queue.sqlite3
COLLECTOR_PSEUDONYMIZATION_KEY=
COLLECTOR_HEARTBEAT_INTERVAL_SECONDS=15
COLLECTOR_OFFLINE_AFTER_SECONDS=60
COLLECTOR_RETRY_BASE_SECONDS=1
COLLECTOR_RETRY_MAX_SECONDS=60
COLLECTOR_REQUEST_TIMEOUT_SECONDS=5
COLLECTOR_API_PORT=8100
COLLECTOR_MAX_EVENT_BYTES=1048576
COLLECTOR_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Set only after the SaaS owner has supplied a deployment URL and credential.
SAAS_INGEST_URL=
COLLECTOR_BEARER_TOKEN=

# Organizer stream values intentionally omitted until the organizer shares details.
ORGANIZER_STREAM_URL=
ORGANIZER_STREAM_AUTH=

# SaaS development settings. Keep separate explicit credentials for local collector delivery
# and dashboard reads. Never expose either value through a VITE_ variable.
# SAAS_DEV_TOKEN is accepted by the development collector ingestion path only.
# SAAS_DASHBOARD_DEV_TOKEN is read-only dashboard access in local development only.
# Production collector credentials use COLLECTOR_BEARER_TOKEN and the same configured IDs.
AEGISOPS_ENV=development
POSTGRES_DB=aegisops
POSTGRES_USER=aegisops
POSTGRES_PASSWORD=aegisops-local-only
SAAS_DATABASE_URL=postgresql+psycopg://aegisops:aegisops-local-only@localhost:5432/aegisops
SAAS_DEV_TOKEN=
SAAS_DASHBOARD_DEV_TOKEN=
INCIDENT_CORRELATION_WINDOW_SECONDS=300

# Browser dashboard auth. Development remains explicit bearer-token-only; production
# requires HTTPS origins, Secure cookies, and SameSite=None for cross-origin hosting.
SAAS_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
DASHBOARD_COOKIE_SECURE=false
DASHBOARD_COOKIE_SAMESITE=lax
DASHBOARD_SESSION_TTL_SECONDS=28800
DASHBOARD_LOGIN_MAX_ATTEMPTS=5
DASHBOARD_LOGIN_WINDOW_SECONDS=900
DASHBOARD_LOGIN_LOCK_SECONDS=900

# Optional advisory reasoning. Keep this key server-side; never use a VITE_ prefix.
OPENROUTER_API_KEY=
AI_ENABLED=true
OPENROUTER_MODEL=openai/gpt-4o-mini
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_TIMEOUT_SECONDS=20
OPENROUTER_MAX_RETRIES=1
